# ClusterMind — environment variables
# Copy this file to .env and fill in values for local development.
# Never commit real secrets to version control.

# ---------------------------------------------------------------------------
# Frontend (Vite — baked in at build time, prefix VITE_ is required)
# ---------------------------------------------------------------------------

# Set to "false" to switch from local demo mode to live API mode.
# In demo mode (default) all data comes from the synthetic fixture in
# src/data/demo-fixture.ts — no backend calls are made.
VITE_DEMO_MODE=false

# Optional: explicit base URL for the backend API.
# Leave unset when the Nitro server serves both frontend and API on the
# same origin (the recommended Cloud Run setup).
# VITE_API_BASE_URL=https://your-api-host.example.com

# ---------------------------------------------------------------------------
# Backend (server-side only — never prefix with VITE_)
# ---------------------------------------------------------------------------

# Gemini API key. When set, POST /api/investigate sends the incident
# evidence to the Gemini model and returns a live analysis.
# When absent the endpoint falls back to the deterministic demo fixture.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for investigation.
# Defaults to gemini-3.5-flash-lite when not set.
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Runtime (read by the Nitro node-server at start time)
# ---------------------------------------------------------------------------

# TCP port the server listens on. Cloud Run sets this automatically.
# Defaults to 3000 when not set.
# PORT=3000
